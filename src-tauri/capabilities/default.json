{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "Permissions for Isle windows",
  "windows": ["island-*", "dock-*", "edge-*", "corners-*", "launcher", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize"
  ]
}
